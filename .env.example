# Required by the default script editor.
OPENAI_API_KEY=

# Configurable model for the live OpenAI adapter; the offline demo needs no key.
OPENAI_MODEL=gpt-5.6-luna

# Provider selection happens only in youai/bootstrap.py.
YOUAI_VIDEO_PROVIDER=kapwing
YOUAI_EMAIL_PROVIDER=console
YOUAI_EMAIL_ADDRESS=creator@example.com

# Runtime configuration.
YOUAI_ROOT=.
YOUAI_DB_PATH=var/youai.db
YOUAI_OUTPUT_DIR=var/media
YOUAI_DOWNLOAD_DIR=var/downloads
YOUAI_REDDIT_USER_AGENT='youai/0.1 (contact: your-reddit-username)'
YOUAI_HEADLESS=false
